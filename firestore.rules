rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Hero content validation
    function isValidHero(data) {
      return data.keys().hasAll(['tag', 'title', 'highlight', 'description', 'descriptionPara2', 'imageUrl'])
        && data.tag is string && data.tag.size() <= 200
        && data.title is string && data.title.size() <= 500
        && data.highlight is string && data.highlight.size() <= 500
        && data.description is string && data.description.size() <= 2000
        && data.descriptionPara2 is string && data.descriptionPara2.size() <= 1000
        && data.imageUrl is string && data.imageUrl.size() <= 1000;
    }

    // Experience validation
    function isValidExperience(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && data.sortOrder is int;
    }

    // Skill validation
    function isValidSkill(data) {
      return data.keys().hasAll(['id', 'name', 'iconName', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 100
        && data.iconName is string && data.iconName.size() <= 100
        && data.sortOrder is int;
    }

    // Award validation
    function isValidAward(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 300
        && data.category is string && data.category.size() <= 100
        && data.sortOrder is int;
    }

    // Project validation
    function isValidProject(data) {
      return data.keys().hasAll(['id', 'code', 'title', 'description', 'imageUrl', 'technologies', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.code is string && data.code.size() <= 50
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 2000
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.technologies is list
        && data.technologies.size() <= 20
        && data.sortOrder is int;
    }

    // Rules for Collections
    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if documentId == 'hero' && isValidHero(request.resource.data);
    }

    match /experiences/{experienceId} {
      allow read: if true;
      allow create, update: if isValidId(experienceId) && isValidExperience(request.resource.data);
      allow delete: if true;
    }

    match /skills/{skillId} {
      allow read: if true;
      allow create, update: if isValidId(skillId) && isValidSkill(request.resource.data);
      allow delete: if true;
    }

    match /awards/{awardId} {
      allow read: if true;
      allow create, update: if isValidId(awardId) && isValidAward(request.resource.data);
      allow delete: if true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId) && isValidProject(request.resource.data);
      allow delete: if true;
    }
  }
}
