rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Hero content validation
    function isValidHero(data) {
      return data.keys().hasAll(['heroTitle', 'heroDescription', 'heroImageBase64'])
        && data.heroTitle is string && data.heroTitle.size() <= 2000
        && data.heroDescription is string && data.heroDescription.size() <= 8000
        && data.heroImageBase64 is string && data.heroImageBase64.size() <= 2000000;
    }

    // Experience validation
    function isValidExperience(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 1000
        && data.description is string && data.description.size() <= 4000;
    }

    // Skill validation
    function isValidSkill(data) {
      return data.keys().hasAll(['id', 'name', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 500;
    }

    // Award validation
    function isValidAward(data) {
      return data.keys().hasAll(['id', 'title', 'sortOrder'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 1000;
    }

    // Portfolio Item validation
    function isValidPortfolioItem(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'imageBase64'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 1000
        && data.description is string && data.description.size() <= 10000
        && data.imageBase64 is string && data.imageBase64.size() <= 2000000;
    }

    // Rules for Collections
    match /siteContent/{documentId} {
      allow read: if true;
      allow write: if (documentId == 'hero' || documentId == 'main') && isValidHero(request.resource.data);
    }

    match /experiences/{experienceId} {
      allow read: if true;
      allow create, update: if isValidId(experienceId) && isValidExperience(request.resource.data);
      allow delete: if true;
    }

    match /skills/{skillId} {
      allow read: if true;
      allow create, update: if isValidId(skillId) && isValidSkill(request.resource.data);
      allow delete: if true;
    }

    match /awards/{awardId} {
      allow read: if true;
      allow create, update: if isValidId(awardId) && isValidAward(request.resource.data);
      allow delete: if true;
    }

    match /portfolioItems/{itemId} {
      allow read: if true;
      allow create, update: if isValidId(itemId) && isValidPortfolioItem(request.resource.data);
      allow delete: if true;
    }
  }
}
